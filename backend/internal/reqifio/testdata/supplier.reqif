      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="_o_h1" LAST-CHANGE="2026-09-02T10:00:00Z">
          <TYPE><SPEC-OBJECT-TYPE-REF>_t_heading</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Braking">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_a_h_chapter</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="_o_r1" LAST-CHANGE="2026-09-02T10:00:00Z">
          <TYPE><SPEC-OBJECT-TYPE-REF>_t_req</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="SR-1">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_a_foreign</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Stop within 40 m">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_a_name</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_a_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>The vehicle <xhtml:strong>shall</xhtml:strong> stop within 40 m from 80 km/h.</xhtml:p>
                <xhtml:table><xhtml:tr><xhtml:th>Surface</xhtml:th><xhtml:th>Distance</xhtml:th></xhtml:tr>
                <xhtml:tr><xhtml:td>Dry</xhtml:td><xhtml:td>40 m</xhtml:td></xhtml:tr></xhtml:table>
                <xhtml:object data="files/curve.ole" type="application/oleobject"><xhtml:object data="files/curve.png" type="image/png">Braking curve</xhtml:object></xhtml:object>
              </xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_a_risk</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>_risk_high</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_a_platforms</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>_pf_a</ENUM-VALUE-REF><ENUM-VALUE-REF>_pf_b</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-REAL THE-VALUE="12.5">
              <DEFINITION><ATTRIBUTE-DEFINITION-REAL-REF>_a_weight</ATTRIBUTE-DEFINITION-REAL-REF></DEFINITION>
            </ATTRIBUTE-VALUE-REAL>
            <ATTRIBUTE-VALUE-INTEGER THE-VALUE="3">
              <DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>_a_count</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION>
            </ATTRIBUTE-VALUE-INTEGER>
            <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="true">
              <DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>_a_safety</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION>
            </ATTRIBUTE-VALUE-BOOLEAN>
            <ATTRIBUTE-VALUE-DATE THE-VALUE="2026-12-01T00:00:00+01:00">
              <DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_a_due</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION>
            </ATTRIBUTE-VALUE-DATE>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="_o_r2" LAST-CHANGE="2026-09-02T10:00:00Z">
          <TYPE><SPEC-OBJECT-TYPE-REF>_t_req</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Warn the driver">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_a_name</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_a_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div>A warning sounds when the brake pressure P<xhtml:sub>b</xhtml:sub> drops, when the brakes <xhtml:em>fade</xhtml:em>.</xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_a_risk</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>_risk_low</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
        </SPEC-OBJECT>
