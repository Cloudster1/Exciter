{
  "nodes": {
    "blockquote": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table"
      ]
    },
    "bulletList": {
      "content": [
        "listItem"
      ]
    },
    "codeBlock": {
      "attrs": {
        "language": {
          "kind": "string",
          "nullable": true,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9+#-]*$"
        }
      },
      "content": [
        "text"
      ]
    },
    "doc": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table"
      ]
    },
    "hardBreak": {
      "inline": true
    },
    "heading": {
      "attrs": {
        "level": {
          "kind": "integer",
          "min": 1,
          "max": 3
        }
      },
      "content": [
        "text",
        "hardBreak",
        "mention"
      ],
      "allowsMarks": true
    },
    "horizontalRule": {},
    "listItem": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table"
      ]
    },
    "mention": {
      "attrs": {
        "id": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "label": {
          "kind": "string",
          "maxLength": 256,
          "pattern": "\\S"
        },
        "mentionSuggestionChar": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "@"
          ]
        }
      },
      "inline": true
    },
    "orderedList": {
      "attrs": {
        "start": {
          "kind": "integer",
          "max": 1000000
        },
        "type": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "1",
            "a",
            "A",
            "i",
            "I"
          ]
        }
      },
      "content": [
        "listItem"
      ]
    },
    "paragraph": {
      "content": [
        "text",
        "hardBreak",
        "mention"
      ],
      "allowsMarks": true
    },
    "table": {
      "content": [
        "tableRow"
      ]
    },
    "tableCell": {
      "attrs": {
        "align": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "colspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        },
        "colwidth": {
          "kind": "integers",
          "nullable": true,
          "max": 4000,
          "maxLength": 100
        },
        "rowspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table"
      ]
    },
    "tableHeader": {
      "attrs": {
        "align": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "colspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        },
        "colwidth": {
          "kind": "integers",
          "nullable": true,
          "max": 4000,
          "maxLength": 100
        },
        "rowspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table"
      ]
    },
    "tableRow": {
      "content": [
        "tableCell",
        "tableHeader"
      ]
    },
    "text": {
      "inline": true
    }
  },
  "marks": {
    "bold": {},
    "code": {},
    "italic": {},
    "link": {
      "attrs": {
        "class": {
          "kind": "null"
        },
        "href": {
          "kind": "string",
          "maxLength": 2048,
          "url": true
        },
        "rel": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "noopener noreferrer nofollow"
          ]
        },
        "target": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "_blank"
          ]
        },
        "title": {
          "kind": "string",
          "nullable": true,
          "maxLength": 256
        }
      }
    },
    "strike": {}
  }
}
