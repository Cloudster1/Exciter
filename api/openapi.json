            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listMembers",
        "summary": "The organization's members, owners first. For administrators.",
        "tags": [
          "members"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Member"
                      }
                    }
                  },
                  "required": [
                    "members"
                  ]
                }
              }
            }
          },
          "default": {
