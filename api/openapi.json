            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Schema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "in",
          "schema"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "routing": {
            "$ref": "#/components/schemas/Stats"
