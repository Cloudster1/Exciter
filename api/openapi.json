                }
              }
            }
          }
        }
      }
    },
    "/meta": {
      "get": {
        "operationId": "meta",
        "summary": "Which product and build answers here.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
