            "$ref": "#/components/schemas/APIError"
          }
        },
        "required": [
          "error"
        ]
      },
      "Info": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
