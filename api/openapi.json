    "/users/{userID}": {
      "delete": {
        "operationId": "removeMember",
        "summary": "Take a member out of the organization; their sessions stop reaching it at once. For administrators.",
        "tags": [
          "members"
        ],
        "parameters": [
          {
            "name": "userID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "setMemberRole",
        "summary": "Give a member another role; the owner's and the caller's own stay. For administrators.",
        "tags": [
          "members"
        ],
        "parameters": [
          {
            "name": "userID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
