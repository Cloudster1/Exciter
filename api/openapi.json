          "lastError": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy"
        ]
      },
      "RequestBody": {
        "type": "object",
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": {
