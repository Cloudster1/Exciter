  },
  "components": {
    "schemas": {
      "APIError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "AuditActor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "event.dead_lettered",
              "audit.exported",
              "member.created",
              "member.role_changed",
              "member.removed"
            ]
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actorName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "description": "A JSON value."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip": {
            "type": "string"
          },
          "targetId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "targetType": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "action",
          "targetType",
          "targetId",
          "actorId",
          "actorName",
          "data",
          "ip",
          "createdAt"
        ]
      },
      "AuditFacets": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "event.dead_lettered",
                "audit.exported",
                "member.created",
                "member.role_changed",
                "member.removed"
              ]
            }
          },
          "actors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditActor"
            }
          },
          "retentionDays": {
            "type": "integer"
          },
          "targetTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "actions",
          "actors",
          "targetTypes",
          "retentionDays"
        ]
      },
      "BuildInfo": {
        "type": "object",
        "properties": {
          "builtAt": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ]
      },
      "Components": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Schema"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "securitySchemes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SecurityScheme"
            }
          }
        },
        "required": [
          "schemas"
        ]
      },
      "CreateMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member",
              "guest"
            ]
          }
        },
        "required": [
          "email",
          "name",
          "role",
          "password"
        ]
      },
      "CreatedMember": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "newAccount": {
            "type": "boolean"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member",
              "guest"
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "role",
          "newAccount"
        ]
      },
      "CurrentOrg": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member",
              "guest"
            ]
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "role"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "components": {
            "$ref": "#/components/schemas/Components"
          },
          "info": {
            "$ref": "#/components/schemas/Info"
          },
          "openapi": {
            "type": "string"
          },
          "paths": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Operation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "security": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
