{
  "openapi": "3.1.0",
  "info": {
    "title": "Exciter",
    "version": "1",
    "description": "The requirements management HTTP API. Every endpoint answers JSON; errors share one envelope. Sign in with a session cookie or an API token sent as a bearer token."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "audit"
    },
    {
      "name": "auth"
    },
    {
      "name": "health"
    },
    {
      "name": "members"
    }
  ],
  "paths": {
    "/audit": {
      "get": {
        "operationId": "listAudit",
        "summary": "Who did what to the organization, newest first; next is the cursor for the window after, null at the end. For administrators.",
        "tags": [
          "audit"
        ],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "description": "One action.",
            "schema": {
              "type": "string",
              "enum": [
                "event.dead_lettered",
                "audit.exported",
                "member.created",
                "member.role_changed",
                "member.removed"
              ]
            }
          },
          {
            "name": "actor",
            "in": "query",
            "description": "The person who acted.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "description": "What kind of thing the entries are about, such as requirement or user.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "description": "The id of the thing the entries are about.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "The first day, YYYY-MM-DD in UTC, or the first instant with its zone.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "The last day, YYYY-MM-DD in UTC and inclusive, or the instant the range ends before.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1 to 200; 50 when absent.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The next of the window before; the first window when absent.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditEntry"
                      }
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "entries",
                    "next"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/audit/export": {
      "get": {
        "operationId": "exportAudit",
        "summary": "The log as a CSV file, newest first, narrowed like the list; the export is itself recorded. Refused with export_too_large past 50000 entries. For administrators.",
        "tags": [
          "audit"
        ],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "description": "One action.",
            "schema": {
              "type": "string",
              "enum": [
                "event.dead_lettered",
                "audit.exported",
                "member.created",
                "member.role_changed",
                "member.removed"
              ]
            }
          },
          {
            "name": "actor",
            "in": "query",
            "description": "The person who acted.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "description": "What kind of thing the entries are about, such as requirement or user.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "description": "The id of the thing the entries are about.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "The first day, YYYY-MM-DD in UTC, or the first instant with its zone.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "The last day, YYYY-MM-DD in UTC and inclusive, or the instant the range ends before.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/audit/facets": {
      "get": {
        "operationId": "auditFacets",
        "summary": "The actions, people and kinds of target the log holds, to narrow it by, and how many days an entry is kept, 0 for ever. For administrators.",
        "tags": [
          "audit"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "facets": {
                      "$ref": "#/components/schemas/AuditFacets"
                    }
                  },
                  "required": [
                    "facets"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
